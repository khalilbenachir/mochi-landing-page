# Copy to .env or .env.local (both git-ignored) and fill in. Public variables are inlined into the public bundle.
# Required for production builds: the public origin, e.g. https://mochi.example
NEXT_PUBLIC_SITE_URL=
# Required for production builds: the real privacy contact address (the app uses support@mochiii.app)
NEXT_PUBLIC_CONTACT_EMAIL=support@mochiii.app
# Optional: the App Store listing; until set, download buttons open the home download section
NEXT_PUBLIC_APP_STORE_URL=

# Optional: Google Tag Manager container ID (GTM-XXXXXXX); GA4 is configured inside GTM. Until set, no tag or cookie banner is rendered.
NEXT_PUBLIC_GTM_ID=
