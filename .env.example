# Copy to .env or .env.local (both git-ignored) and fill in. Public variables are inlined into the public bundle.
# Required for production builds: the public origin, e.g. https://mochi.example
NEXT_PUBLIC_SITE_URL=
# Required for production builds: the real privacy contact address
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional: the App Store listing; until set, download buttons open the home download section
NEXT_PUBLIC_APP_STORE_URL=

# Optional: public newsletter form URL accepting a POST field named email. Never put a secret here.
# Without this, Subscribe opens an email request to support@mochiii.app.
NEXT_PUBLIC_NEWSLETTER_FORM_ACTION=
